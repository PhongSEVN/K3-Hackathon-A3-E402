API_KEY=your_api_key_here
SECRET_KEY=change-me-generate-with-secrets-token-hex

# Postgres (docker-compose db service)
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=5432

# Match host/port above; asyncpg driver required by backend
DATABASE_URL=postgresql+asyncpg://hackathon:hackathon@localhost:5432/hackathon
