API_KEY_OPEN_AI=your_api_key_here
SECRET_KEY=change-me-generate-with-secrets-token-hex

# Postgres (docker-compose db service)
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon
POSTGRES_PORT=5432

# Match host/port above; asyncpg driver required by backend
DATABASE_URL=postgresql+asyncpg://hackathon:hackathon@localhost:5432/hackathon

# MinIO (docker-compose minio service)
MINIO_ROOT_USER=hackathon
MINIO_ROOT_PASSWORD=hackathon123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hackathon
MINIO_SECRET_KEY=hackathon123
MINIO_USE_SSL=false
MINIO_BUCKET_PLANT_IMAGES=plant-images
MINIO_BUCKET_AVATARS=avatars

# ChromaDB (docker-compose chroma service)
CHROMA_PORT=8001
CHROMA_HOST=localhost
